# LiteLLM proxy (required)
LITELLM_HOST=https://<your-litellm-proxy>/
LITELLM_API_KEY=sk-...

# Model alias defined in the LiteLLM proxy config
MODEL_ID=bedrock-claude-4-sonnet

# Storage backend: "local" (default) or "s3"
STORE_BACKEND=local

# Local store path (STORE_BACKEND=local)
STORE_DIR=./docscribe_store

# S3 store (STORE_BACKEND=s3)
# S3_BUCKET=my-bucket
# S3_FOLDER=docscribe
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# MCP server port
MCP_PORT=8000
